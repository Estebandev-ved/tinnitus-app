# ============================
# TinnitOff Production Config
# ============================
# Copy to .env and fill in real values

# ----- Backend (Spring Boot) -----

# PostgreSQL
DB_USERNAME=tinnitoff
DB_PASSWORD=CHANGE_ME_strong_password_here

# JWT (min 32 chars, random string)
JWT_SECRET=CHANGE_ME_random_32plus_chars_here

# Clinical sync token (must match mobile app)
CLINICAL_SYNC_TOKEN=CHANGE_ME_random_token_here

# Admin user seed (DataInitializer) — nunca dejes el valor por defecto
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_here
ADMIN_EMAIL=tu-correo@dominio.com

# Grafana admin password
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# Firebase service account path (inside container)
FIREBASE_SA=/app/serviceAccount.json
# Alternativa sin archivo (Railway): contenido JSON de la cuenta de servicio, o ese JSON en base64
# FIREBASE_SA_JSON=
# CORS (backend prod): origenes separados por comas; incluye https://localhost y capacitor://localhost
# CORS_ORIGINS=

# Proveedor de IA (solo backend): anthropic | azure. Vacio = anthropic si hay ANTHROPIC_API_KEY, si no azure.
# AI_PROVIDER=
# Anthropic (proveedor por defecto). Nunca la expongas al frontend.
ANTHROPIC_API_KEY=CHANGE_ME_anthropic_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=500

# Azure OpenAI (alternativa) — usada solo por el backend (proxy de IA). Nunca la expongas al frontend.
AZURE_OPENAI_API_KEY=CHANGE_ME_azure_key_here
AZURE_OPENAI_ENDPOINT=https://tu-recurso.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=tu-deployment
# Limites de uso del asistente por usuario (opcionales, valores por defecto entre parentesis)
# AI_LIMIT_PER_MINUTE=6
# AI_LIMIT_PER_DAY=40
# AI_LIMIT_TOKENS_PER_DAY=60000
# El backend necesita FIREBASE_SA (cuenta de servicio) para verificar los ID tokens de Firebase.

# ----- Frontend (Vite build) -----
# Estas variables quedan embebidas en el bundle del navegador (son públicas).
# Nunca pongas aquí secretos de backend (JWT, DB, llaves de Azure).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Spring Boot. Obligatorio para el asistente de IA: debe ser una URL HTTPS publica en produccion
# (la app web y Android no pueden llamar a http:// desde https://). Vacio = asistente en modo basico.
VITE_BACKEND_URL=http://localhost:8080
